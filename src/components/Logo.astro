<g fill="var(--m-dark,#22422B)"><circle cx="40.0" cy="19.6" r="3.9"/><circle cx="38.7" cy="25.1" r="3.8"/><circle cx="35.5" cy="28.9" r="4.3"/><circle cx="31.7" cy="31.2" r="4.5"/><circle cx="26.1" cy="32.5" r="4.4"/><circle cx="20.2" cy="31.9" r="3.8"/><circle cx="14.5" cy="28.9" r="5.0"/><circle cx="11.5" cy="25.5" r="4.0"/><circle cx="10.0" cy="19.7" r="5.2"/><circle cx="11.2" cy="15.1" r="4.3"/><circle cx="15.2" cy="10.5" r="3.8"/><circle cx="20.1" cy="8.2" r="4.1"/><circle cx="24.1" cy="7.5" r="3.9"/><circle cx="30.3" cy="8.3" r="5.0"/><circle cx="35.1" cy="10.7" r="4.6"/><circle cx="39.0" cy="15.5" r="4.3"/><circle cx="21.6" cy="19.1" r="4.2"/><circle cx="28.2" cy="29.1" r="5.3"/><circle cx="20.8" cy="28.1" r="5.4"/><circle cx="21.2" cy="29.8" r="6.1"/><circle cx="25.4" cy="28.7" r="5.6"/><circle cx="33.5" cy="13.1" r="4.9"/><circle cx="29.8" cy="19.5" r="5.3"/><circle cx="25.2" cy="15.5" r="5.5"/><circle cx="36.1" cy="22.3" r="6.3"/><circle cx="13.3" cy="15.2" r="4.9"/><circle cx="21.4" cy="11.7" r="5.7"/><circle cx="12.7" cy="22.9" r="6.8"/><circle cx="13.7" cy="21.5" r="4.2"/><circle cx="21.6" cy="11.2" r="7.0"/></g>
