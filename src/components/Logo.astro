---
// Temporary logo after the entrance sign and the brand board (ref-02, ref-03 concept 1, ref-08):
// mark with a round tree crown and trunk, a winding path, water with reed, a small church tower
// on the horizon and two birds; NAESCAS in Cormorant caps (0.12em) with CAMPING · HET GROENE HART
// in Lato caps (0.2em) below. Colours come from --m-* custom properties (light and dark version).
// Placeholder until the designer delivers the final logo.
interface Props {
  /** light version for dark backgrounds */
  light?: boolean;
  /** stacked mark above the text (footer) */
  stacked?: boolean;
  /** mark only, no word mark (horeca card) */
  markOnly?: boolean;
  class?: string;
}
const { light = false, stacked = false, markOnly = false, class: cls } = Astro.props;
---

<span class:list={['logo', { 'logo--light': light, 'logo--stacked': stacked }, cls]}>
  <svg class="logo__mark" viewBox="0 -7 100 71" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
