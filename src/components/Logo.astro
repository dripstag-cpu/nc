<g fill="var(--m-dark,#22422B)" opacity=".55"><circle cx="30.6" cy="20.4" r="3.3"/><circle cx="24.6" cy="27.0" r="2.3"/><circle cx="27.5" cy="24.1" r="2.3"/><circle cx="29.9" cy="26.9" r="2.7"/><circle cx="29.1" cy="25.0" r="2.4"/><circle cx="33.4" cy="26.8" r="2.2"/></g></g>
<path d="M4.4 57Q3.6 53.5 1.8 52.5M4.7 57Q4.3 53.5 3.4 51.2M5.0 57Q5.0 53.5 5.0 50.0M5.3 57Q5.7 53.5 6.6 51.2M5.6 57Q6.4 53.5 8.2 52.5M9.4 55.5Q8.6 51.2 6.8 50.0M9.6 55.5Q9.2 51.2 8.1 48.8M9.9 55.5Q9.7 51.2 9.4 47.6M10.1 55.5Q10.3 51.2 10.6 47.6M10.4 55.5Q10.8 51.2 11.9 48.8M10.6 55.5Q11.4 51.2 13.2 50.0M13.9 53.6Q13.1 50.6 11.3 49.7M14.2 53.6Q13.8 50.6 12.9 48.7M14.5 53.6Q14.5 50.6 14.5 47.6M14.8 53.6Q15.2 50.6 16.1 48.7M15.1 53.6Q15.9 50.6 17.7 49.7M35.9 51Q35.1 48.0 33.9 47.1M36.3 51Q36.0 48.0 35.6 45.7M36.7 51Q37.0 48.0 37.4 45.7M37.1 51Q37.9 48.0 39.1 47.1M30.4 52.6Q29.6 50.4 28.8 49.7M30.8 52.6Q30.5 50.4 30.3 48.6M31.2 52.6Q31.5 50.4 31.7 48.6M31.6 52.6Q32.4 50.4 33.2 49.7" stroke="var(--m-line,#22422B)" stroke-width=".7"/>
<path d="M88.6 62V43.6M91.6 62V39M94.6 62V45.4M86 62c0-6 1-11.2 3.6-14.6M97.6 61c0-5-1-9.6-3.4-12.6M93 62c.4-5.6 2.2-9.6 5-12M83.6 62.6c.4-4 1.4-7 3.2-9" stroke="var(--m-line,#22422B)" stroke-width=".7"/>
<path d="M91.6 39.4v-4.2M88.6 43.8v-3.4M94.6 45.2v-2.8" stroke="var(--m-reed,#8C6B45)" stroke-width="1.7"/>
  </svg>
  {!markOnly && (
    <span class="logo__text">
      <span class="logo__name" translate="no">NAESCAS</span>
      <span class="logo__descriptor">Camping · Het Groene Hart</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--c-green-dark);
  }
  .logo--light {
    color: var(--c-offwhite);
    --m-dark: #b6c2af;
    --m-light: #e9e4d7;
    --m-trunk: #e9e4d7;
    --m-ground: rgba(182, 194, 175, 0.45);
    --m-mid: rgba(125, 151, 113, 0.75);
    --m-path: #faf7f2;
    --m-water: #7d9771;
    --m-line: #e9e4d7;
    --m-soft: #b6c2af;
    --m-reed: #c9a87e;
  }
  .logo--stacked { flex-direction: column; align-items: center; gap: 0.5rem; text-align: center; }
  .logo__mark { flex: none; width: auto; height: 48px; }
  .logo--stacked .logo__mark { height: 72px; }
  .logo__text { display: grid; justify-items: start; line-height: 1; }
  .logo--stacked .logo__text { justify-items: center; }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.75rem;
    letter-spacing: 0.12em;
    margin-right: -0.12em;
  }
  .logo__descriptor {
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    opacity: 0.85;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .logo__mark { height: 56px; }
    .logo__name { font-size: 2rem; }
    .logo__descriptor { font-size: 0.625rem; }
  }
</style>
