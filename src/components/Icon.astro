  leafsprig: '<path d="M12 21.5V7.5"/><path d="M12 18c-3.2-.3-5.6-2.4-6.3-5.6 3.2.2 5.6 2.3 6.3 5.6zM12 18c3.2-.3 5.6-2.4 6.3-5.6-3.2.2-5.6 2.3-6.3 5.6z"/><path d="M12 13c-2.6-.5-4.3-2.5-4.6-5.2 2.6.4 4.3 2.4 4.6 5.2zM12 13c2.6-.5 4.3-2.5 4.6-5.2-2.6.4-4.3 2.4-4.6 5.2z"/><path d="M12 8.4c-1-1.7-1-3.6 0-5.4 1 1.8 1 3.7 0 5.4z"/>',
