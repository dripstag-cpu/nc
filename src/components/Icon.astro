---
// Inline line icons, redrawn after the owner's mockups (decisions.md v3, Iconenstijl): thin line,
// round caps and joins, no fill, one 24x24 grid. Origin and use per icon: ICONEN.md.
// Line weight scales with the size so it stays about 1.5px on screen, as in the mockups.
import type { IconName } from './icon-names';
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 24, label, class: cls } = Astro.props;
const weight = size >= 30 ? 1.05 : size >= 22 ? 1.3 : 1.55;

const paths: Record<IconName, string> = {
  // kernwaarden row (ref-04): two leaves, walking figure, bicycle, songbird
