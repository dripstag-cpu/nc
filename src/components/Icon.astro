  bird: '<path d="M3.6 17.6c3.2.2 6-.6 7.8-2.6 1.7-1.9 2.2-4.9 3.7-6.9 1.2-1.6 3.4-2 4.8-.6l1.6.8-1.8.5c.4 4.8-2.8 8.6-7.6 9.4-2.6.4-5.8.2-8.5-.6z"/><path d="M8.6 15.6c1.8-.2 3.6-1.6 4.6-3.4"/><path d="M12.2 18.4l-.6 2.8M14.6 17.8l.2 3.2M10.6 21.2h2.4M13.4 21h2.4"/><path d="M3.6 17.6L1.6 19"/><circle cx="18.4" cy="8.9" r=".3"/>',
