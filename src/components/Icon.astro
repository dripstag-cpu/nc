  // Verblijf (ref-07, p09) and the brand board icon row (ref-08)
  shower: '<path d="M12 3v3"/><path d="M6.8 11.4a5.2 5.2 0 0 1 10.4 0z"/><path d="M8.6 14.4v.4M12 14.4v.4M15.4 14.4v.4M10.3 17.2v.4M13.7 17.2v.4M8.6 20v.4M12 20v.4M15.4 20v.4"/>',
