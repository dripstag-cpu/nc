  facebook: '<path d="M13.4 20v-7h2.4l.4-2.7h-2.8V8.6c0-.8.3-1.3 1.4-1.3h1.5V4.9a18 18 0 0 0-2.1-.1c-2.1 0-3.5 1.3-3.5 3.5v2h-2.3V13h2.3v7"/>',
  instagram: '<rect x="4.5" y="4.5" width="15" height="15" rx="4.2"/><circle cx="12" cy="12" r="3.5"/><circle cx="16.4" cy="7.6" r=".6"/>',
  tripadvisor: '<circle cx="7.6" cy="13.4" r="3.4"/><circle cx="16.4" cy="13.4" r="3.4"/><circle cx="7.6" cy="13.4" r=".9"/><circle cx="16.4" cy="13.4" r=".9"/><path d="M3 9.6c2.6-2.2 5.6-3.2 9-3.2s6.4 1 9 3.2M12 13.4l-1.4 2.6M12 13.4l1.4 2.6"/>',
};
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>
