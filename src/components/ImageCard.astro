---
// Large image card from the homepage mockup (ref-04): photo over the whole card, dark gradient at the
// bottom, Cormorant title and one Lato line in offwhite, chevron in a thin circle bottom right.
// Whole card is a link.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { Img } from '../data/images';

interface Props {
  title: string;
  text?: string;
  href: string;
  image: Img;
  /** use the copy's alt when it fits the image */
  alt?: string;
  level?: 'h2' | 'h3';
  /** CSS aspect ratio from 900px */
  ratio?: string;
  /** fixed height from 900px instead of the ratio (homepage cards, mockup: about 250px) */
  height?: number;
}
const { title, text, href, image, alt, level = 'h3', ratio = '2 / 1', height } = Astro.props;
const Heading = level;
---

<a class:list={['image-card', { 'image-card--fixed': height }]} href={href} style={`--card-ratio:${ratio};${height ? `--card-h:${height}px` : ''}`}>
  <Picture
    class="image-card__img"
    src={image.src}
    alt={alt ?? image.alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200].filter((w) => w <= image.src.width)}
    sizes="(min-width: 900px) 460px, 100vw"
    loading="lazy"
    decoding="async"
  />
  <span class="image-card__shade" aria-hidden="true"></span>
  <span class="image-card__body">
    <Heading class="image-card__title">{title}</Heading>
    {text && <span class="image-card__text">{text}</span>}
  </span>
  <span class="image-card__chevron" aria-hidden="true"><Icon name="chevron" size={18} /></span>
</a>

<style>
  .image-card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    color: var(--c-offwhite);
    text-decoration: none;
    background: var(--c-green-dark);
    box-shadow: var(--shadow-card);
  }
  .image-card :global(picture), .image-card :global(.image-card__img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .image-card :global(.image-card__img) { object-fit: cover; transition: transform 500ms var(--ease); }
  .image-card:hover :global(.image-card__img) { transform: scale(1.03); }
  .image-card__shade {
    position: absolute;
    inset: 0;
    /* dark only in the lower 55 percent, the photo stays visible above it (mockup) */
    background: linear-gradient(to top, rgba(18, 36, 23, 0.9) 0%, rgba(18, 36, 23, 0.74) 30%, rgba(18, 36, 23, 0.4) 46%, rgba(18, 36, 23, 0) 60%);
  }
  .image-card__body { position: absolute; left: 0; right: 4rem; bottom: 0; display: grid; gap: 0.3rem; padding: var(--sp-4) var(--sp-5) var(--sp-5); }
  .image-card__title { font-size: clamp(1.5rem, 0.6vw + 1.25rem, 1.75rem); font-weight: 500; color: var(--c-offwhite); line-height: 1.1; text-shadow: 0 1px 10px rgba(10, 24, 14, 0.45); }
  .image-card__text { font-size: 0.8125rem; line-height: 1.45; max-width: 40ch; text-shadow: 0 1px 6px rgba(10, 24, 14, 0.5); }
  .image-card__chevron {
    position: absolute;
    right: var(--sp-5);
    bottom: var(--sp-5);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(250, 247, 242, 0.75);
    border-radius: 50%;
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .image-card:hover .image-card__chevron { transform: translateX(3px); background: rgba(250, 247, 242, 0.14); }
  .image-card:hover { color: var(--c-offwhite); }
  .image-card:focus-visible { outline: var(--focus-ring); outline-offset: 3px; }
  @media (min-width: 900px) {
    .image-card { aspect-ratio: var(--card-ratio); }
    .image-card--fixed { aspect-ratio: auto; height: var(--card-h); }
  }
</style>
