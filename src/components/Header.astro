---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav, bookingCta, site } from '../data/site';

const current = Astro.url.pathname;
const isCurrent = (href: string) => (current === href || (href !== '/' && current.startsWith(href)) ? 'page' : undefined);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">
      <Logo />
    </a>

    <nav class="primary-nav" aria-label="Hoofdmenu">
      <ul role="list">
        {mainNav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={bookingCta.href}><Icon name="calendar" size={19} />{bookingCta.label}</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      Menu
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
    <div class="container mobile-menu__top">
      <Logo light />
      <button class="menu-toggle menu-toggle--close" type="button" data-menu-close>Sluiten</button>
    </div>
    <nav class="container mobile-menu__nav" aria-label="Hoofdmenu mobiel">
      <ul role="list">
        {mainNav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--light mobile-menu__cta" href={bookingCta.href}><Icon name="calendar" size={18} />{bookingCta.label}</a>
      {site.phone && <a class="mobile-menu__phone" href={site.phone.href}>Bel {site.phone.display}</a>}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--c-paper) var(--grain);
    border-bottom: 1px solid rgba(34, 66, 43, 0.12);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-6);
    min-height: var(--header-h);
  }
  .site-header__brand { display: inline-flex; min-height: 48px; align-items: center; text-decoration: none; }
  .site-header__brand:hover { color: inherit; }

  /* menu centred between logo and button, equal spacing, caps 13px (mockup) */
  .primary-nav { display: none; flex: 1; justify-content: center; }
  .primary-nav ul { display: flex; gap: clamp(1rem, 2.4vw - 0.8rem, 2rem); }
  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    white-space: nowrap;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-green-dark);
  }
  /* thin underline under the active page, olive on hover */
  .primary-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.08em;
    bottom: 9px;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform var(--dur) var(--ease);
  }
  .primary-nav a:hover { color: var(--c-green-olive); }
  .primary-nav a:hover::after { transform: scaleX(1); opacity: 0.5; }
  .primary-nav a[aria-current='page']::after { transform: scaleX(1); opacity: 1; }

  .site-header__cta { display: none; white-space: nowrap; min-height: 44px; padding-inline: 1.25rem 1.4rem; gap: 0.6rem; }

  .menu-toggle {
    min-height: 48px;
    min-width: 48px;
    padding: 0 var(--sp-4);
    border: 1.5px solid currentColor;
    border-radius: var(--radius-btn);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-green-dark);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--c-green-dark);
    color: var(--c-offwhite);
  }
  .mobile-menu :focus-visible { outline-color: var(--c-offwhite); }
  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    border-bottom: 1px solid rgba(250, 247, 242, 0.14);
  }
  .menu-toggle--close { color: var(--c-offwhite); }
  .mobile-menu__nav { padding-block: var(--sp-6) var(--sp-12); }
  .mobile-menu__nav ul { display: grid; }
  .mobile-menu__nav li { border-bottom: 1px solid rgba(250, 247, 242, 0.14); }
  .mobile-menu__nav li a {
    display: flex;
    align-items: center;
    min-height: 60px;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 500;
    color: var(--c-offwhite);
    text-decoration: none;
  }
  .mobile-menu__nav li a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.25em; }
  .mobile-menu__cta { width: 100%; margin-top: var(--sp-10); }
  .mobile-menu__phone {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 56px;
    margin-top: var(--sp-3);
    color: var(--c-offwhite);
    font-weight: 700;
  }

  @media (min-width: 1180px) {
    .primary-nav { display: flex; }
    .site-header__cta { display: inline-flex; }
    .menu-toggle:not(.menu-toggle--close) { display: none; }
  }
</style>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = menu?.querySelector<HTMLButtonElement>('[data-menu-close]');

  if (openBtn && menu && closeBtn) {
    const focusables = () =>
      Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const close = () => {
      menu.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKey);
      openBtn.focus();
    };

    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      // keep focus inside the dialog
      const items = focusables();
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };

    openBtn.addEventListener('click', () => {
      menu.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKey);
      closeBtn.focus();
    });
    closeBtn.addEventListener('click', close);
    // closing on a same-page anchor link
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { if (!menu.hidden) close(); }));
  }
</script>
