---
// /camping/: the terrain, for whom (and not), location, house rules, facilities in short, map.
// Copy from camping.md, layout per decisions.md v2.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RichText from '../components/RichText.astro';
import FactRow from '../components/FactRow.astro';
import Figure from '../components/Figure.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbs } from '../data/jsonld';
import { img } from '../data/images';
import { pageCopy } from '../lib/page-copy';
import { section, toPlain } from '../lib/copy';
import { iconFor, labeled, listItems, need, paragraphs } from '../lib/sections';

const copy = await pageCopy('camping');
const s = (n: string) => need(section(copy, n), n);
const intro = s('Intro');
const terrain = s('Het terrein');
const stays = s('Wat je hier kunt verblijven');
const forWho = s('Voor wie is Naescas');
const notFor = s('Voor wie niet');
const location = s('Ligging aan het Aarkanaal');
const rules = s('Huisregels');
const facilities = s('Faciliteiten in het kort');
const map = s('Plattegrond');
const book = s('Boek je verblijf');
const introParas = paragraphs(intro.blocks);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  jsonLd={breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Camping', path: copy.meta.slug }])}
>
  <PageHero title={copy.meta.h1} sub={toPlain(introParas.slice(0, 1))} image={img.luchtfoto} accent={'Ruimte om\ntot rust te komen'} />

  <section class="section bg-offwhite" aria-labelledby="terrain-title">
    <div class="container camp-two reveal">
      <div class="camp-text">
        <RichText blocks={introParas.slice(1)} class="lead" />
        <h2 id="terrain-title">{terrain.name}</h2>
        <RichText blocks={terrain.blocks} />
      </div>
      <Figure image={img.laan.src} alt={img.laan.alt} ratio="3 / 2" widths={[480, 800, 1000]} sizes="(min-width: 900px) 520px, 100vw" />
    </div>
  </section>

  <section class="section bg-cream" aria-labelledby="stays-title">
    <div class="container reveal"><div class="camp-text">
      <h2 id="stays-title">{stays.name}</h2>
      <RichText blocks={stays.blocks} />
      <a class="btn btn--primary" href="/verblijf/">{stays.buttons[0]?.label ?? 'Alle verblijven bekijken'}</a>
    </div></div>
  </section>

  <section class="section bg-offwhite" aria-label="Voor wie">
    <div class="container camp-who reveal">
      <div class="camp-who__col">
        <Icon name="check" size={28} class="camp-who__yes" />
        <h2>{forWho.name}</h2>
        <RichText blocks={forWho.blocks} />
      </div>
      <div class="camp-who__col">
        <Icon name="x" size={28} class="camp-who__no" />
        <h2>{notFor.name}</h2>
        <RichText blocks={notFor.blocks} />
      </div>
    </div>
  </section>

  <section class="section bg-sage" aria-labelledby="loc-title">
    <div class="container reveal"><div class="camp-text">
      <h2 id="loc-title">{location.name}</h2>
      <RichText blocks={location.blocks} />
      <a class="btn btn--secondary" href="/omgeving/">{location.buttons[0]?.label ?? 'Ontdek de omgeving'}</a>
    </div></div>
  </section>

  <section class="section bg-offwhite" aria-labelledby="rules-title">
    <div class="container reveal">
      <h2 id="rules-title" class="camp-h2">{rules.name}</h2>
      <FactRow columns={3} items={listItems(rules.blocks).map(labeled).map((f) => ({ icon: iconFor(f.label), label: f.label, value: f.value }))} />
    </div>
  </section>

  <section class="section bg-cream" aria-label="Faciliteiten en plattegrond">
    <div class="container camp-two reveal">
      <div class="camp-text">
        <h2>{facilities.name}</h2>
        <RichText blocks={facilities.blocks} />
        <a class="btn btn--secondary" href="/faciliteiten/">{facilities.buttons[0]?.label ?? 'Alle faciliteiten'}</a>
      </div>
      <div class="camp-text">
        <h2>{map.name}</h2>
        <div class="camp-map"><Icon name="map" size={40} /><RichText blocks={map.blocks} /></div>
      </div>
    </div>
  </section>

  <section class="section bg-dark" aria-labelledby="book-title">
    <div class="container camp-book reveal">
      <h2 id="book-title">{book.name}</h2>
      <RichText blocks={book.blocks} />
      <a class="btn btn--light" href="/beschikbaarheid/">{book.buttons[0]?.label ?? 'Bekijk beschikbaarheid'}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .camp-two { display: grid; gap: var(--sp-10); align-items: start; }
  .camp-text { display: grid; gap: var(--sp-4); justify-items: start; align-content: start; max-width: 52rem; }
  .camp-who { display: grid; gap: var(--sp-8); }
  .camp-who__col { display: grid; gap: var(--sp-3); align-content: start; padding: var(--sp-8); background: var(--c-paper) var(--grain); border: var(--border-card); border-radius: var(--radius-card); }
  .camp-who__col h2 { font-size: clamp(1.75rem, 1vw + 1.4rem, 2.25rem); }
  .camp-who :global(.camp-who__yes) { color: var(--c-green-olive); }
  .camp-who :global(.camp-who__no) { color: var(--c-brown); }
  .camp-h2 { margin-bottom: var(--sp-8); }
  .camp-map { display: grid; justify-items: center; gap: var(--sp-3); width: 100%; padding: var(--sp-12) var(--sp-6); border: 1px dashed var(--c-sage); border-radius: var(--radius-card); background: var(--c-offwhite); color: var(--c-green-olive); text-align: center; }
  .camp-book { display: grid; justify-items: center; gap: var(--sp-4); text-align: center; }
  @media (min-width: 900px) {
    .camp-two { grid-template-columns: 1.2fr 1fr; gap: var(--sp-16); }
    .camp-who { grid-template-columns: 1fr 1fr; }
  }
</style>
