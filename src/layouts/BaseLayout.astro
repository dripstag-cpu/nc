---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import { faces, fontFaceCss } from '../styles/fonts';
import { site, noStickyBarPaths } from '../data/site';
import ogDefault from '../assets/images/hero-hutten-aan-het-pad.jpg';

interface Props {
  title: string;
  description: string;
  /** path only, e.g. "/verblijf/"; defaults to the current URL */
  path?: string;
  /** absolute URL or site path of a 1200x630 image; defaults to a crop of the terrain photo */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** null entries are skipped (e.g. a FAQPage without finished answers) */
  jsonLd?: Record<string, unknown> | (Record<string, unknown> | null)[];
  /** mobile booking bar; forced off on /beschikbaarheid/ and /reserveren/ */
  stickyBar?: boolean;
}

const {
  title,
  description,
  path,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
  stickyBar = true,
} = Astro.props;

const base = (Astro.site?.toString() ?? site.url).replace(/\/$/, '');
const canonicalPath = path ?? Astro.url.pathname;
const canonical = `${base}${canonicalPath}`;

const og = ogImage ?? (await getImage({ src: ogDefault, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src;
const ogImageUrl = og.startsWith('http') ? og : `${base}${og}`;

const blocks = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).filter((b): b is Record<string, unknown> => b !== null);
const showStickyBar = stickyBar && !noStickyBarPaths.includes(Astro.url.pathname);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F2EEE4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {faces.filter((f) => f.preload).map((f) => (
      <link rel="preload" href={f.url} as="font" type="font/woff2" crossorigin />
    ))}
    <style is:inline set:html={fontFaceCss}></style>

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />

    {blocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Direct naar de inhoud</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {showStickyBar && <StickyBar />}

    <script>
      // One fade-in per section; content stays visible without JS or with reduced motion
      const els = document.querySelectorAll('.reveal');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
